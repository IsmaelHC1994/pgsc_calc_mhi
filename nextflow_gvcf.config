/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    gVCF Processing Extension for pgscalc Pipeline
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    This config extends the base pgscalc configuration with gVCF processing capabilities
    It should be used alongside the base nextflow.config
----------------------------------------------------------------------------------------
*/

// Add gVCF-specific parameters to existing params
params {
    // gVCF processing parameters
    input_type = 'vcf'  // 'vcf' or 'gvcf'
    
    // gVCF-specific inputs (only used when input_type = 'gvcf')
    gvcf_files = null
    reference_db = null      // PLINK archive with HGDP+1kGP reference
    reference_genome = null  // FASTA reference genome
}

// gVCF-specific profiles that extend existing profiles
profiles {
    gvcf {
        // Profile specifically for gVCF processing
        params.input_type = 'gvcf'
        // Use existing resource limits from base config, but can override if needed
        params.max_memory = '32.GB'
        params.max_cpus = 8
        params.max_time = '48.h'
    }
    
    gvcf_high_mem {
        // High memory profile for large gVCF files
        params.input_type = 'gvcf'
        params.max_memory = '64.GB'
        params.max_cpus = 16
        params.max_time = '72.h'
    }
    
    // Combine gVCF with existing profiles
    gvcf_docker {
        // gVCF processing with Docker container support
        params.input_type = 'gvcf'
        docker.enabled = true
        conda.enabled = false
        singularity.enabled = false
    }
    
    gvcf_singularity {
        // gVCF processing with Singularity container support
        params.input_type = 'gvcf'
        singularity.enabled = true
        conda.enabled = false
        docker.enabled = false
    }
}
